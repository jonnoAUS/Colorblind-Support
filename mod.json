{
    "geode": "5.6.1",
    "gd": {
        "win": "2.2081",
        "android": "2.2081"
    },
    "id": "realgares.colorblind-support",
    "name": "Colorblind Support",
    "version": "1.0.1",
    "developer": "RealGares",
    "description": "Colorblind support for Geometry Dash!",
    "tags": [ "customization", "utility", "enhancement"],
    "settings": {
        "enabled": {
            "type": "bool",
            "name": "Enabled",
            "description": "Enables or disables the colorblind filter.",
            "default": true
        },
        "mode": {
            "type": "string",
            "name": "Colorblind Mode",
            "description": "Controls which colorblind profile is used.",
            "default": "Deuteranopia",
            "one-of": [
                "Deuteranopia",
                "Protanopia",
                "Tritanopia",
                "Achromatopsia"
            ]
        },
        "strength": {
            "type": "float",
            "name": "Strength",
            "description": "Controls how strongly the selected colorblind filter is applied.",
            "default": 0.8,
            "min": 0,
            "max": 1,
            "control": {
                "slider": true,
                "slider-step": 0.05,
                "input": false
            }
        }
    },
    "resources": {
        "files": [
            "resources/colorblind_post.vert",
            "resources/colorblind_post.frag"
        ]
    }
}
